# ==============================================================================
# CrewFlow - Production Environment Configuration for crm.bytebunkers.sbs (StackCP)
# ==============================================================================
# Copy this file to .env on your server and fill in your actual production credentials:
# cp .env.production.example .env
# ==============================================================================

APP_NAME="CrewFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.bytebunkers.sbs

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# Initial Superadmin Account (Automatically created on first deployment if empty)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@crm.bytebunkers.sbs
ADMIN_INITIAL_PASSWORD=ChangeThisPassword123!

# ------------------------------------------------------------------------------
# Database Settings (StackCP -> Web Tools -> MySQL Databases)
# ------------------------------------------------------------------------------
# Create a MySQL database and user in your StackCP panel, then enter them here:
# On StackCP, DB_HOST is usually localhost or the host listed on your MySQL page.
DB_CONNECTION=mysql
DB_HOST=shareddb-m.hosting.stackcp.net
DB_PORT=3306
DB_DATABASE=wfa-crm-3130313f75
DB_USERNAME=wfa-crm-3130313f75
DB_PASSWORD="rtbepa-cet5rC-zmyxtg"

# ------------------------------------------------------------------------------
# Session, Cache & Queue Settings (Database Driver for Reliable Shared Hosting)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# File Storage (Private evidence files stored on persistent server disk)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Email (StackCP Mailboxes or External SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.bytebunkers.sbs
MAIL_PORT=465
MAIL_USERNAME=notifications@bytebunkers.sbs
MAIL_PASSWORD="zWkjmd-yac6eh-cdchcu"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@bytebunkers.sbs"
MAIL_FROM_NAME="CrewFlow"

# ------------------------------------------------------------------------------
# Stripe Billing (Optional - enter when enabling paid subscriptions)
# ------------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
